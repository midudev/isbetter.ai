# connect-src has to stay scheme-wide: the "Local" provider points at whatever
# OpenAI-compatible server the user runs — a LAN IP, a VPN host, a tunnel — and
# CSP cannot express "any private address". Model-generated code never runs on
# this origin: preview documents get their own strict policy (connect-src
# 'none') plus a sandboxed iframe, see PREVIEW_CSP in src/scripts/lib.ts.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; base-uri 'none'; connect-src 'self' https: http:; font-src 'self' data:; form-action 'self'; frame-ancestors 'self'; frame-src 'self' blob:; img-src 'self' data: blob:; manifest-src 'self'; media-src 'self' data: blob:; object-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; worker-src 'none'
