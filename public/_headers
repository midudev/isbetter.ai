# connect-src has to stay scheme-wide: the "Local" provider points at whatever
# OpenAI-compatible server the user runs — a LAN IP, a VPN host, a tunnel — and
# CSP cannot express "any private address".
#
# Preview iframes use srcdoc, which INHERITS and INTERSECTS this policy with
# PREVIEW_CSP. Sources here must therefore be a superset of what demos need
# (CDN scripts/styles/assets, workers, wasm). Model code still runs only inside
# a sandboxed opaque-origin iframe — see PREVIEW_CSP in src/scripts/lib.ts.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; base-uri 'none'; connect-src 'self' https: http: ws: wss: blob:; font-src 'self' data: https: http:; form-action 'self'; frame-ancestors 'self'; frame-src 'self' blob:; img-src 'self' data: blob: https: http:; manifest-src 'self'; media-src 'self' data: blob: https: http:; object-src 'none'; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval' https: http: blob:; style-src 'self' 'unsafe-inline' https: http:; worker-src 'self' blob: https: http:
